# Server Configuration
PORT=3000
NODE_ENV=development

# Database (PostgreSQL 16 + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geosphere

# Security & JWT
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Logging
LOG_LEVEL=debug

# CORS Origins (Allow Machine 2 Web App and other clients)
# Add your Web App machine IP or domain here (comma-separated):
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
