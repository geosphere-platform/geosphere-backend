# Server Configuration
PORT=3000
NODE_ENV=development

# Database (PostgreSQL 17 + PostGIS 3.5 — matches database/docker-compose.yml)
DATABASE_URL=postgresql://geosphere_admin:gis_dev_password@localhost:5432/geosphere_db
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000

# Security & Authentication (JWT HS256)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_REFRESH_SECRET=super_secret_refresh_key_at_least_32_characters_long
JWT_EXPIRES_IN=15m

# CORS Allowed Origins (Comma-separated client URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MIN=120
RATE_LIMIT_WINDOW_MS=60000

# Storage Provider Configuration ('local' or 's3')
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
# S3_BUCKET_NAME=gis-saas-uploads
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# Observability & Logging
LOG_LEVEL=info
ENABLE_METRICS=true
